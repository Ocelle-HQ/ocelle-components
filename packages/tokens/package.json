{
  "name": "@ocelle/tokens",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ocelle-HQ/ocelle-components.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.ts && cp ../../LICENSE ../../NOTICE ../../THIRD_PARTY_NOTICES ."
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
