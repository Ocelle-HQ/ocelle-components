# Spec Kit machine-local state
.specify/.workflow-install.lock
.specify/workflows/runs/

# Dependencies and generated output (root paths only; plants may track dist/)
node_modules/
packages/*/dist/
# The elements package's packed copies of the root LICENSE, NOTICE and THIRD_PARTY_NOTICES (005 research.md R-15)
packages/elements/LICENSE
packages/elements/NOTICE
packages/elements/THIRD_PARTY_NOTICES
# The tokens and styles packages' packed copies of the root licence files (030 research.md R-04)
packages/tokens/LICENSE
packages/tokens/NOTICE
packages/tokens/THIRD_PARTY_NOTICES
packages/styles/LICENSE
packages/styles/NOTICE
storybook/dist/
storybook/.generated/
.stryker-tmp/
reports/
__screenshots__/
# Vitest browser mode's failure-screenshot attachments
.vitest/
*.tsbuildinfo
storybook/.visual/
storybook/.cache/
