               {
                    "created": "2026-11-01T17:53:06.889890342Z",
                    "created_by": "RUN |9 DEBIAN_FRONTEND=noninteractive TZ=America/Los_Angeles DOCKER_IMAGE_NAME_TEMPLATE=mcr.microsoft.com/playwright:v%version%-noble NODE_VERSION=26 #= autogenerated= via= ./update-playwright-node.mjs= UBUNTU_MIRROR_PREFIX=azure. /bin/sh -c find /etc/apt -type f \\( -name '*.list' -o -name '*.sources' \\)       -exec sed -i \"s|http://archive.ubuntu.com|http://${UBUNTU_MIRROR_PREFIX}archive.ubuntu.com|g; s|http://ports.ubuntu.com|http://${UBUNTU_MIRROR_PREFIX}ports.ubuntu.com|g\" {} + &&     apt-get update &&     apt-get install -y curl wget gpg ca-certificates &&     mkdir -p /etc/apt/keyrings &&     curl -sL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg &&     echo \"deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_VERSION}.x nodistro main\" >> /etc/apt/sources.list.d/nodesource.list &&     apt-get update &&     apt-get install -y nodejs &&     apt-get install -y --no-install-recommends git openssh-client zstd &&     npm install -g yarn &&     rm -rf /var/lib/apt/lists/* &&     adduser pwuser # buildkit",
                    "comment": "buildkit.dockerfile.v0"
               },
               {
                    "created": "2026-11-01T17:53:06.889890342Z",
                    "created_by": "ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright",
                    "comment": "buildkit.dockerfile.v0",
                    "empty_layer": true
               },
               {
                    "created": "2026-11-01T17:53:07.053261383Z",
                    "created_by": "COPY ./playwright-core.tar.gz /tmp/playwright-core.tar.gz # buildkit",
                    "comment": "buildkit.dockerfile.v0"
               },
               {
                    "created": "2026-11-01T17:56:03.889001092Z",
                    "created_by": "RUN |9 DEBIAN_FRONTEND=noninteractive TZ=America/Los_Angeles DOCKER_IMAGE_NAME_TEMPLATE=mcr.microsoft.com/playwright:v%version%-noble NODE_VERSION=26 #= autogenerated= via= ./update-playwright-node.mjs= UBUNTU_MIRROR_PREFIX=azure. /bin/sh -c install -d -m 777 /ms-playwright /ms-playwright/.links &&     mkdir /ms-playwright-agent &&     cd /ms-playwright-agent && npm init -y &&     npm i /tmp/playwright-core.tar.gz &&     npm exec --no -- playwright-core mark-docker-image \"${DOCKER_IMAGE_NAME_TEMPLATE}\" &&     npm exec --no -- playwright-core install-deps &&     rm -rf /var/lib/apt/lists/* # buildkit",
                    "comment": "buildkit.dockerfile.v0"
               },
               {
                    "created": "2026-11-01T17:56:14.249368722Z",
                    "created_by": "RUN |9 DEBIAN_FRONTEND=noninteractive TZ=America/Los_Angeles DOCKER_IMAGE_NAME_TEMPLATE=mcr.microsoft.com/playwright:v%version%-noble NODE_VERSION=26 #= autogenerated= via= ./update-playwright-node.mjs= UBUNTU_MIRROR_PREFIX=azure. /bin/sh -c cd /ms-playwright-agent &&     npm exec --no -- playwright-core install chromium &&     chmod -R 777 /ms-playwright/chromium-* /ms-playwright/chromium_headless_shell-* /ms-playwright/ffmpeg-* # buildkit",
                    "comment": "buildkit.dockerfile.v0"
               },
               {
                    "created": "2026-11-01T17:56:19.949192363Z",
                    "created_by": "RUN |9 DEBIAN_FRONTEND=noninteractive TZ=America/Los_Angeles DOCKER_IMAGE_NAME_TEMPLATE=mcr.microsoft.com/playwright:v%version%-noble NODE_VERSION=26 #= autogenerated= via= ./update-playwright-node.mjs= UBUNTU_MIRROR_PREFIX=azure. /bin/sh -c cd /ms-playwright-agent &&     npm exec --no -- playwright-core install firefox &&     chmod -R 777 /ms-playwright/firefox-* # buildkit",
                    "comment": "buildkit.dockerfile.v0"
               },
               {
                    "created": "2026-11-01T17:56:25.121997414Z",
                    "created_by": "RUN |9 DEBIAN_FRONTEND=noninteractive TZ=America/Los_Angeles DOCKER_IMAGE_NAME_TEMPLATE=mcr.microsoft.com/playwright:v%version%-noble NODE_VERSION=26 #= autogenerated= via= ./update-playwright-node.mjs= UBUNTU_MIRROR_PREFIX=azure. /bin/sh -c cd /ms-playwright-agent &&     npm exec --no -- playwright-core install webkit &&     rm /tmp/playwright-core.tar.gz &&     rm -rf /ms-playwright-agent &&     rm -rf ~/.npm/ &&     chmod -R 777 /ms-playwright/webkit-* # buildkit",
