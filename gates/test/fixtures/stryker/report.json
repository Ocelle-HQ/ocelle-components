      "source": "import { expect, it } from \"vitest\";\nimport { clamp, label } from \"../lib/sample.ts\";\nit(\"clamps\", () => {\n  expect(clamp(5, 0, 3)).toBe(3);\n  expect(clamp(-1, 0, 3)).toBe(0);\n});\nit(\"labels\", () => {\n  expect(typeof label(1)).toBe(\"string\");\n});\n"
